[Unit]
Description=Peltier Development API
After=network-online.target
Wants=network-online.target

[Service]
User=peltdev
Group=peltdev
WorkingDirectory=/opt/peltdev/backend
# ONE worker on purpose: one payment-watcher thread, one SQLite writer.
ExecStart=/opt/peltdev/venv/bin/gunicorn --workers 1 --threads 8 --bind 127.0.0.1:8000 --timeout 60 --access-logfile - wsgi:app
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/peltdev

[Install]
WantedBy=multi-user.target
